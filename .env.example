# OSC Mixer Configuration
OSC_HOST=192.168.1.70
OSC_PORT=10023
OSC_PROTOCOL=OSCX32M32

# Resolver/bulk scan limits. Keep these aligned with the physical mixer.
# X32/M32: 32 / 16 / 8 / 8
# XR16 rack profile used by LiveStageAssistant: 16 / 4 / 4 / 4
OSC_CHANNEL_COUNT=32
OSC_BUS_COUNT=16
OSC_FX_COUNT=8
OSC_DCA_COUNT=8

# Optional recognized-speaker mapping for first-person monitor/channel requests.
# Example: {"laurent":{"bus":"Laurent","channel":"Talk Laurent"}}
XMS_SPEAKER_MAP=

# Optional Streamable HTTP MCP transport
HTTP_HOST=0.0.0.0
HTTP_PORT=8787
# MCP_AUTH_TOKEN=change-me
