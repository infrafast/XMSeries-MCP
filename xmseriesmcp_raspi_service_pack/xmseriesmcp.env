# XMSeries-MCP Raspberry Pi configuration
# Copy to: /etc/xmseriesmcp.env

XM_DIR=/home/pi/XMSeries-MCP

HTTP_HOST=0.0.0.0
HTTP_PORT=8787
HTTP_PUBLIC_HOST=100.96.255.63

# Optional. Leave empty to disable auth.
MCP_AUTH_TOKEN=

# Direct LAN access from Raspberry to mixer
OSC_HOST=192.168.100.16
OSC_PORT=10024
OSC_PROTOCOL=OSCXR

# Optional JSON map for recognized-speaker monitor/channel context.
# Example: {"laurent":{"bus":"Laurent","channel":"Talk Laurent"}}
XMS_SPEAKER_MAP=

OSC_CHANNEL_COUNT=16
OSC_BUS_COUNT=4
OSC_FX_COUNT=4
OSC_DCA_COUNT=4

DEBUG=false
